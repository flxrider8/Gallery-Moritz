name: Portfolio Dates

# Erzeugt portfolio/_dates.json (Upload-Datum pro Bild),
# damit die Galerie die neuesten Bilder immer oben zeigen kann.
on:
  push:
    branches: [main]
    paths:
      - 'portfolio/**'
      - '!portfolio/_dates.json'
  workflow_dispatch:

permissions:
  contents: write

jobs:
  dates:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Upload-Datum pro Bild ermitteln
        run: |
          python3 - <<'PY'
          import json, os, subprocess
          folder = 'portfolio'
          exts = ('.jpg', '.jpeg', '.png', '.webp')
          out = {}
          for name in sorted(os.listdir(folder)):
              if not name.lower().endswith(exts):
                  continue
              log = subprocess.run(
                  ['git', 'log', '--follow', '--diff-filter=A', '--format=%aI', '--', f'{folder}/{name}'],
                  capture_output=True, text=True
              ).stdout.strip().splitlines()
              if log:
                  out[name] = log[-1]  # ältester "Added"-Commit = echtes Upload-Datum, auch nach Umbenennen (VERKAUFT - ...)
          with open(f'{folder}/_dates.json', 'w', encoding='utf-8') as f:
              json.dump(out, f, ensure_ascii=False, indent=2, sort_keys=True)
          print(f'{len(out)} Bilder')
          PY

      - name: Committen
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add portfolio/_dates.json
          git diff --staged --quiet || (git commit -m "chore: portfolio dates aktualisieren" && git push)
